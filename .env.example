# Copie para .env (local) ou cadastre cada linha como variável de ambiente no serviço de hospedagem.

# Quem pode entrar (usuário único)
APP_USERNAME=wanderson
# Use UMA das duas opções abaixo. A segunda é mais segura: gere com  npm run hash-password -- "sua senha"
APP_PASSWORD=troque-por-uma-senha-longa
# APP_PASSWORD_HASH=scrypt$16384$8$1$...

# Segredo que assina o cookie de sessão (opcional; se vazio, é gerado e guardado em DATA_DIR)
# SESSION_SECRET=
SESSION_DAYS=30

# Onde ficam o banco (SQLite) e as capas. Na nuvem, aponte para o volume/disco persistente.
DATA_DIR=./data
PORT=3000

# Atrás de proxy HTTPS (Fly, Render, Railway, Nginx...): 1
TRUST_PROXY=0
# Cookie só via HTTPS (ligado automaticamente com NODE_ENV=production)
# COOKIE_SECURE=1

# Importa seed/entries.json na primeira execução, se o banco estiver vazio (0 desliga)
AUTO_SEED=1

# Capas automáticas dos filmes/séries (opcional): chave gratuita do TMDB — veja DEPLOY.md
# TMDB_API_KEY=
